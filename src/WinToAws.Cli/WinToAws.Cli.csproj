<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinToAwsCli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wintoaws</ToolCommandName>
    <PackageId>WinToAws.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>VENKATESHWAR REDDY VURUMALLA</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Command-line tool for the WinToAws library: analyse a Windows application and generate AWS artefacts.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinToAws\WinToAws.csproj" />
  </ItemGroup>
</Project>
